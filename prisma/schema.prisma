generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  teachers  Teacher[]
  students  Student[]
}

model Teacher {
  id        Int       @id @default(autoincrement())
  name      String
  subject   String
  createdAt DateTime  @default(now())

  ownerId   Int?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  students  Student[]

  @@index([ownerId])
}

model Student {
  id        Int       @id @default(autoincrement())
  name      String
  age       Int
  createdAt DateTime  @default(now())

  teacherId Int?

  teacher Teacher? @relation(fields: [teacherId], references: [id])
  ownerId Int?
  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
